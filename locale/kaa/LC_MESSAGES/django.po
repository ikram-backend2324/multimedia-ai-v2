#: core/views.py:93 core/views.py:95 core/views.py:98 templates/home.html:41
#: templates/home.html:128 templates/home.html:254
msgid "Tasvir"
msgstr "Súwret"

#: core/views.py:34
msgid ""
"Chuqur CNN ImageNet musobaqasida g'alaba qozonib, zamonaviy AI davrini "
"boshladi."
msgstr ""
"Tereń CNN ImageNet jarısında jeńiske erisip, zamanagóy AI dáwirin basladı."

#: core/views.py:35 core/views.py:49 core/views.py:93
msgid "Generatsiya"
msgstr "Generaciya"

#: core/views.py:36
msgid ""
"Generativ raqobat tarmoqlari — ikki tarmoq bir-biriga qarshi o'qib, "
"realistik tasvir yaratadi."
msgstr ""
"Generativ básekilesiw tarmaqları — eki tarmaq bir-birine qarsı oqıp, "
"realistik súwret jaratadı."

#: core/views.py:38
msgid ""
"Residual bog'lanishlar 150+ qatlamli tarmoqlarni o'qitishni mumkin qildi."
msgstr "Residual baylanıslar 150+ qatlamlı tarmaqlardı oqıtıwdı múmkin etti."

#: core/views.py:39 core/views.py:47 core/views.py:97 templates/home.html:50
#: templates/home.html:255
msgid "Audio"
msgstr "Audio"

#: core/views.py:40
msgid ""
"Tabiiy ovoz sintezi uchun xom audio to'lqinini generatsiya qiluvchi model."
msgstr ""
"Tábiyiy dawıs sintezi ushın shiyki audio tolqının generaciyalawshı model."

#: core/views.py:41
msgid "Arxitektura"
msgstr "Arxitektura"

#: core/views.py:42
msgid ""
"\"Attention is all you need\" — barcha modalliklar uchun asos bo'lgan "
"arxitektura."
msgstr ""
"\"Attention is all you need\" — barlıq modallıqlar ushın tiykar bolǵan "
"arxitektura."

#: core/views.py:44
msgid ""
"Vision Transformer tasvirni patchlarga bo'lib, transformer bilan qayta "
"ishlaydi."
msgstr ""
"Vision Transformer súwretti patchlarǵa bólip, transformer menen qayta "
"isleydi."

#: core/views.py:45
msgid "Multimodal"
msgstr "Multimodal"

#: core/views.py:46
msgid "Tasvir va matnni bitta makonda bog'lab, nol-misolli tasnifni ochdi."
msgstr ""
"Súwret hám tekstti bir keńislikte baylap, nol-mısallı klassifikaciyanı "
"ashtı.Súwret hám tekstti bir keńislikte baylap, nol-mısallı klassifikaciyanı"
" ashtı."

#: core/views.py:48
msgid ""
"680 ming soat audio asosida o'qitilgan ko'p tilli nutqni aniqlash modeli."
msgstr ""
"680 mıń saat audio tiykarında oqıtılǵan kóp tilli sóylewdi anıqlaw modeli."

#: core/views.py:50
msgid ""
"Ochiq diffuziya modeli matndan yuqori sifatli tasvir yaratishni "
"ommalashtirdi."
msgstr ""
"Ashıq diffuziya modeli tekstten joqarı sapalı súwret jaratıwdı keń tarqattı."

#: core/views.py:51 core/views.py:99 templates/home.html:59
#: templates/home.html:256
msgid "Video"
msgstr "Video"

#: core/views.py:52
msgid ""
"Matndan realistik video generatsiya qiluvchi diffuzion transformer modeli."
msgstr ""
"Teksten realistik video generaciyalawshı diffuziyalıq transformer modeli."

#: core/views.py:64
msgid "Konvolyutsion neyron tarmoq"
msgstr "Konvolyucion neyron tarmaq"

#: core/views.py:65
msgid ""
"Tasvirdagi piksellardan bosqichma-bosqich xususiyatlarni ajratib oladi."
msgstr ""
"Súwrettegi pikellerden basqıshpa-basqısh ózgesheliklerdi ajıratıp aladı."

#: core/views.py:66
msgid ""
"CNN tasvirni kichik filtrlar (yadrolar) bilan skanerlaydi. Birinchi "
"qatlamlar qirralar va ranglarni, keyingilari shakllar va butun obyektlarni "
"aniqlaydi. Har bir qatlam oldingisidan murakkabroq xususiyatlarni o'rganadi."
msgstr ""
"CNN súwretti kishkene filtrler (yadrolar) menen skanerleydi. Birinshi "
"qatlamlar shetlerdi hám reńlerdi, keyingileri formalardı hám pútkil "
"obyektlerdi anıqlaydı. Hár bir qatlam aldıńǵısınan quramalıraq "
"ózgesheliklerdi úyrenedi."

#: core/views.py:67
msgid "Tasvir tasnifi, yuzni aniqlash, tibbiy tasvir tahlili"
msgstr "Súwret klassifikaciyası, júzdi anıqlaw, medicinalıq súwret talqılawı"

#: core/views.py:68
msgid "Generativ raqobat tarmog'i"
msgstr "Generativ básekilesiw tarmaǵı"

#: core/views.py:69
msgid "Ikki tarmoq raqobatlashib, yangi realistik tasvir yaratadi."
msgstr "Eki tarmaq básekilesip, jańa realistik súwret jaratadı."

#: core/views.py:70
msgid ""
"GAN ikki qismdan iborat: generator soxta tasvir yaratadi, diskriminator esa "
"uni haqiqiydan ajratishga harakat qiladi. Ular bir-biriga qarshi o'qib, "
"generator borgan sari ishonchli natija beradi."
msgstr ""
"GAN eki bólimnen ibarat: generator jasalma súwret jaratadı, diskriminator "
"bolsa onı haqıyqıydan ajıratıwǵa háreket etedi. Olar bir-birine qarsı oqıp, "
"generator barǵan sayın isenimli nátiyje beredi."

#: core/views.py:71
msgid "Yuz generatsiyasi, uslubni ko'chirish, tasvir sifatini oshirish"
msgstr "Júz generaciyası, uslubtı kóshiriw, súwret sapasın asırıw"

#: core/views.py:72
msgid "Diffuziya modeli"
msgstr "Diffuziya modeli"

#: core/views.py:73
msgid "Shovqindan boshlab, bosqichma-bosqich aniq tasvir hosil qiladi."
msgstr "Shawqınnan baslap, basqıshpa-basqısh anıq súwret payda etedi."

#: core/views.py:74
msgid ""
"Diffuziya modeli avval tasvirga shovqin qo'shishni, so'ngra uni teskari "
"yo'nalishda tozalashni o'rganadi. Generatsiyada u sof shovqindan boshlab, "
"har qadamda biroz tozalab, oxir-oqibat aniq tasvir yaratadi. Stable "
"Diffusion va DALL-E shu asosda ishlaydi."
msgstr ""
"Diffuziya modeli aldın súwretke shawqın qosıwdı, sońınan onı keri baǵdarda "
"tazalawdı úyrenedi. Generaciyada ol sap shawqınnan baslap, hár qádemde biraz"
" tazalap, aqır-aqıbet anıq súwret jaratadı. Stable Diffusion hám DALL-E usı "
"tiykarda isleydi."

#: core/views.py:75
msgid "Matndan tasvir, inpainting, tasvirni kengaytirish"
msgstr "Teksten súwret, inpainting, súwretti keńeytiw"

#: core/views.py:76
msgid "Transformer arxitekturasi"
msgstr "Transformer arxitekturası"

#: core/views.py:77
msgid "\"Attention\" mexanizmi orqali kontekstdagi bog'lanishlarni topadi."
msgstr "\"Attention\" mexanizmi arqalı konteksttegi baylanıslardı tabadı."

#: core/views.py:78
msgid ""
"Transformer ma'lumotni ketma-ket emas, parallel qayta ishlaydi. \"Self-"
"attention\" har bir element boshqalarga qanchalik bog'liqligini hisoblaydi. "
"Bu arxitektura matn, tasvir (ViT) va audioda ham asos bo'ldi."
msgstr ""
"Transformer maǵlıwmattı izbe-iz emes, parallel qayta isleydi. \"Self-"
"attention\" hár bir element basqalarǵa qanshelli baylanıslı ekenin "
"esaplaydı. Bul arxitektura tekst, súwret (ViT) hám audioda da tiykar boldı."

#: core/views.py:79
msgid "Til modellari, ViT, multimodal tizimlar"
msgstr "Til modelleri, ViT, multimodal sistemalar"

#: core/views.py:80
msgid "Nutqni aniqlash modeli"
msgstr "Sóylewdi anıqlaw modeli"

#: core/views.py:81
msgid "Audioni matnga aylantiradi, 90+ tilni qo'llab-quvvatlaydi."
msgstr "Audionı tekstke aylandıradı, 90+ tildi qollap-quwwatlaydı."

#: core/views.py:82
msgid ""
"Whisper audioni spektrogrammaga aylantirib, transformer orqali matnga "
"o'giradi. 680 ming soatlik turli tildagi audio asosida o'qitilgani uchun "
"shovqinli muhitda ham yaxshi ishlaydi."
msgstr ""
"Whisper audionı spektrogrammaǵa aylandırıp, transformer arqalı tekstke "
"ógeredi. 680 mıń saatlıq túrli tildegi audio tiykarında oqıtılǵanı ushın "
"shawqınlı ortalıqta da jaqsı isleydi."

#: core/views.py:83
msgid "Subtitr yaratish, ovozli yordamchilar, tarjima"
msgstr "Subtitr jaratıw, dawıslı járdemshiler, awdarma"

#: core/views.py:84
msgid "Tasvir-matn bog'lovchi"
msgstr "Súwret-tekst baylanıstırıwshı"

#: core/views.py:85
msgid "Tasvir va matnni bitta umumiy makonda bog'laydi."
msgstr "Súwret hám tekstti bir ulıwma keńislikte baylaydı."

#: core/views.py:86
msgid ""
"CLIP tasvir va uning matnli tavsifini bir vektor makoniga joylashtiradi, "
"shunda mos juftliklar yaqin turadi. Bu modelga oldindan ko'rmagan toifalarni"
" ham tanib olish (zero-shot) imkonini beradi."
msgstr ""
"CLIP súwret hám onıń tekstli táriypin bir vektor keńisligine jaylastıradı, "
"sonda sáykes jupların jaqın turadı. Bul modelge aldınnan kórmegen "
"kategoriyalardı da tanıw (zero-shot) múmkinshiligin beredi."

#: core/views.py:87
msgid "Tasvirni qidirish, nol-misolli tasnif, generativ modellarni boshqarish"
msgstr ""
"Súwretti izlew, nol-mısallı klassifikaciya, generativ modellerdi basqarıw"

