msgstr "Diffuziya"

#: templates/home.html:190
msgid "Avtoregressiv"
msgstr "Avtoregressiv"

#: templates/home.html:195
msgid "Modellar jadvali"
msgstr "Modeller kestesi"

#: templates/home.html:196
msgid ""
