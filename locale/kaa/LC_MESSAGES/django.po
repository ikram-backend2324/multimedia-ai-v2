msgstr "Modeller tariyxı"

#: templates/home.html:149
msgid ""
"2012-yildan bugungi kungacha multimedia AI rivojlanishidagi asosiy "
"bosqichlar."
msgstr ""
"2012-jıldan búgingi kúnge shekem multimedia AI rawajlanıwındaǵı tiykarǵı "
"basqıshlar."

#: templates/home.html:169
msgid "Tasvirni tanib olish aniqligi"
msgstr "Súwretti tanıw dálligi"

#: templates/home.html:170
#, python-format
msgid ""
"ImageNet test to'plamidagi Top-5 aniqlik (%% ). Past xato = yaxshi model."
msgstr ""
"ImageNet test toplamındaǵı Top-5 dállik (%% ). Tómen qátelik = jaqsı model."

#: templates/home.html:182
msgid "Generativ modellar: tezlik va sifat"
msgstr "Generativ modeller: tezlik hám sapa"

#: templates/home.html:183
msgid "GAN, diffuziya va avtoregressiv modellarni taqqoslash (nisbiy baho)."
msgstr ""
"GAN, diffuziya hám avtoregressiv modellerdi salıstırıw (salıstırмалı "
"baha).GAN, diffuziya hám avtoregressiv modellerdi salıstırıw (salıstırмалы "
"baha)."

