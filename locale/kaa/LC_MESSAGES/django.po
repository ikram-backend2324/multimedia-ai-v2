msgstr "Diffuziya: shawqınnan súwretke"

#: templates/home.html:123
msgid ""
"Slayderni suring — model shovqinni bosqichma-bosqich tasvirga aylantiradi."
msgstr ""
"Slayderdi súyreń — model shawqındı basqıshpa-basqısh súwretke aylandıradı."

#: templates/home.html:126
msgid "Shovqin"
msgstr "Shawqın"

#: templates/home.html:130
msgid "Qadam"
msgstr "Qádem"

#: templates/home.html:133
msgid "CNN: konvolyutsiya filtri"
msgstr "CNN: konvolyuciya filtri"

#: templates/home.html:134
msgid ""
"Filtr ustiga bosing — u tasvir bo'ylab siljib, xususiyatlarni ajratadi."
msgstr ""
"Filtr ústine basıń — ol súwret boylap jıljıp, ózgesheliklerdi ajıratadı."

#: templates/home.html:137
msgid "Filtrlarni ishga tushirish"
msgstr "Filtrlerdi iske túsiriw"

#: templates/home.html:139
msgid "Filtr: qirralarni aniqlash"
msgstr "Filtr: shetlerdi anıqlaw"

#: templates/home.html:148
