#: templates/home.html:14
msgid ""
"Sun'iy intellekt tasvirni ko'radi, ovozni eshitadi va videoni tushunadi. "
"Ushbu modellar qanday ishlashini o'rganing, taqqoslang va AI yordamchidan "
"so'rang."
msgstr ""
"Jasalma intellekt súwretti kóredi, dawıstı esitedi hám videonı túsinedi. Bul"
" modellerdiń qalay islewin úyreniń, salıstırıń hám AI járdemshiden sorań."

