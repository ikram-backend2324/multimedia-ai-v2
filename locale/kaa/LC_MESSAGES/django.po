#: templates/home.html:32
msgid "Uchta modallik, bitta maqsad"
msgstr "Úsh modallıq, bir maqset"

#: templates/home.html:33
msgid ""
"Multimedia AI uch oqim bilan ishlaydi. Har biri o'ziga xos model "
"arxitekturasiga ega."
msgstr ""
"Multimedia AI úsh aǵıs penen isleydi. Hár biri ózine tán model "
"arxitekturasına iye."

#: templates/home.html:42
msgid ""
"Tasvirni tanib olish, segmentatsiya va generatsiya. CNN, ViT, GAN va "
"diffuziya modellari."
msgstr ""
"Súwretti tanıw, segmentaciya hám generaciya. CNN, ViT, GAN hám diffuziya "
"modelleri."

#: templates/home.html:51
msgid ""
"Nutqni matnga aylantirish, ovoz sintezi va musiqa generatsiyasi. Whisper, "
"Wav2Vec, TTS."
msgstr ""
"Sóylewdi tekstke aylandırıw, dawıs sintezi hám muzıka generaciyası. Whisper,"
" Wav2Vec, TTS."

#: templates/home.html:60
msgid ""
"Videoni tahlil qilish, harakatni aniqlash va video generatsiya. Sora, "
"kadrlar interpolyatsiyasi."
msgstr ""
"Videonı talqılaw, háreketti anıqlaw hám video generaciya. Sora, kadrlar "
"interpolyaciyası."

#: templates/home.html:70
msgid "Har bir modallik qanday qayta ishlanadi"
msgstr "Hár bir modallıq qalay qayta islenedi"

#: templates/home.html:71
msgid ""
"Tasvir, audio va video xom signaldan modelga tushunarli ko'rinishga qanday "
"o'tadi."
msgstr ""
"Súwret, audio hám video shiyki signaldan modelge túsinikli kóriniske qalay "
"ótedi."

#: templates/home.html:92
msgid "Asosiy modellar — chuqurroq"
msgstr "Tiykarǵı modeller — tereńirek"

#: templates/home.html:93
msgid ""
"Har bir modelni ochib, qanday ishlashi va qayerda qo'llanilishini o'qing."
msgstr "Hár bir modeldi ashıp, qalay islewin hám qayerde qollanılıwın oqıń."

#: templates/home.html:106
msgid "Qo'llanilishi:"
msgstr "Qollanılıwı:"

#: templates/home.html:117
