# ===== OpenRouter =====
# Paste your real OpenRouter API key below (keep it secret, never commit this file)
OPENROUTER_API_KEY=sk-or-v1-PASTE_YOUR_KEY_HERE
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Multimodal (vision) model used by the "Aqlli AI" mode in /api/vision/.
# This is a paid model — make sure your OpenRouter account has credits.
OPENROUTER_VISION_MODEL=meta-llama/llama-4-maverick

# ===== Django =====
DJANGO_SECRET_KEY=change-this-to-a-long-random-string-in-production
DJANGO_DEBUG=True
# Comma-separated hosts for production, e.g. multimedia-ai.onrender.com
ALLOWED_HOSTS=

# ===== Optional: auto-create an admin on deploy =====
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
